{
  "name": "gitclip",
  "private": true,
  "version": "0.1.0",
  "description": "Sync git commits and pipe logs back to Claude Code through a browser-only channel.",
  "workspaces": [
    "web",
    "mcp",
    "netlify/functions"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "test": "npm --workspace web run test -- --run",
    "test:watch": "npm --workspace web run test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "netlify-cli": "^25.6.1"
  }
}
