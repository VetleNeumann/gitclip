# NOTE: bin/sandcastle does not load this file. It sources auth from the
# host instead:
#   GH_TOKEN        ← `gh auth token`
#   OPENAI_API_KEY           ← `bw get password openai-api-key`         (codex agent)
#   CLAUDE_CODE_OAUTH_TOKEN  ← `bw get password claude-code-oauth-token` (claude agent)
#
# Nothing from ~/.claude is bind-mounted into a sandbox any more; the claude leg
# carries its own long-lived token, minted with `claude setup-token`. See ADR-0058.
#
# This file remains only as a reference for the env vars the orchestrator
# reads from `process.env`. Pasting values here has no effect.

OPENAI_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=
